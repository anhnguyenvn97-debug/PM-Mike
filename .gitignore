# --- environment, rebuildable ---
.venv/
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/

# --- machine-local, not portable ---
# Absolute paths and a permission allowlist specific to this laptop.
.claude/settings.local.json
.claude/voice-history/

# --- Windows / Excel debris ---
Thumbs.db
desktop.ini
~$*.csv
~$*.xlsx

# NOT ignored, on purpose:
#   data/eod.parquet  and  data/raw/*.csv
# get_index_constituents has no as-of-date parameter, so it always returns
# CURRENT index membership. The parquet snapshot is the only historical record
# of what VN100 held on a past date -- it cannot be rebuilt if lost.
