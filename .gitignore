# --- environment, rebuildable ---
.venv/
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/

# --- machine-local, not portable ---
# Absolute paths and a permission allowlist specific to this laptop.
.claude/settings.local.json
.claude/voice-history/

# --- Windows / Excel debris ---
Thumbs.db
desktop.ini
~$*.csv
~$*.xlsx

# --- derived, rebuildable ---
# ingest.py rebuilds market.db from data/fiinpro/ on every run, so it is a pure
# function of files that ARE tracked. A binary rewritten whole on each build has
# no business in git history. local_history.db is the same, from
# data/fiinpro/archive/ via the legacy load_history.py (backtester only).
data/market.db
data/market.db.building
data/market.db*.wal
data/local_history.db
data/local_history.db.building
data/local_history.db*.wal

# --- rejected drops, kept locally for reference only ---
data/fiinpro/rejected/

# NOT ignored, on purpose:
#   data/fiinpro/*.xlsx, data/fiinpro/archive/*.xlsx
# FiinPro adjusts prices AS OF THE EXTRACT DATE, so re-downloading the same
# date range later returns different *_adj values. These exports are the only
# record of the adjustment state they were pulled under: not reproducible,
# therefore tracked.
#
#   data/market.txt, data/local_history.txt, data/params/*.csv
# Small, diffable, regenerated every build. Their diffs record how the stores
# and parameters changed between commits.
